 UI MODULE : TOAST CORE
 Version   : v1.1.1
 Status    : CLEAN / PRODUCTION
=====================================================
-->

<style>
/* ===============================
   TOAST SYSTEM
=============================== */
.toast-container {
  position: fixed;
  left: 50%;
  bottom: 60px;
  transform: translateX(-50%);
  z-index: 9999;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;

  pointer-events: none;
}

.toast {
  min-width: 200px;
  max-width: 90vw;
  padding: 8px 12px;
  border-radius: 4px;

  background: #222;
  color: #fff;
  font-size: 18px;
  text-align: center;

  opacity: 0;
  transition: opacity 0.2s ease;
}

.toast.show { opacity: 1; }

.toast.info    { background: #1565c0; }
.toast.success { background: #2e7d32; }
.toast.error   { background: #c62828; }
.toast.warn    { background: #ed6c02; }

/* ===============================
   LOADER (NON-BLOCKING)
=============================== */
#uiLoader {
  position: fixed;
  inset: 0;
  z-index: 9997;

  display: none;
  align-items: center;
  justify-content: center;

  background: #f5f5fa;
  pointer-events: none;
}

#uiLoader.show {
  display: flex;
}

#uiLoader > span {
  padding: 8px 12px;
  font-size: 18px;
  font-weight: 600;
  color: #000;
}
</style>

<!-- ===============================
     LOADER MARKUP
=============================== -->
<div id="uiLoader">
  <span id="uiLoaderText">1</span>
</div>

<script>
(function () {

  /* ===============================
     TOAST API (GLOBAL)
=============================== */
  let toastContainer;

  function ensureToastContainer() {
    if (!toastContainer) {
      toastContainer = document.createElement('div');
      toastContainer.className = 'toast-container';
      document.body.appendChild(toastContainer);
    }
  }

  window.toast = function (message, options = {}) {
    ensureToastContainer();

    const type = options.type || 'info';
    const duration = options.duration ?? 2000;

    const el = document.createElement('div');
    el.className = `toast ${type}`;
    el.innerHTML = message;

    toastContainer.appendChild(el);
    requestAnimationFrame(() => el.classList.add('show'));

    setTimeout(() => {
      el.classList.remove('show');
      setTimeout(() => el.remove(), 300);
    }, duration);
  };

  window.hideAllToasts = function () {
    document.querySelectorAll('.toast').forEach(el => el.remove());
  };

  /* ===============================
     LOADER API (GLOBAL)
=============================== */
  (function () {

    let _timer = null;
    let _count = 1;
    let _shown = false;

    window.Loader = {

      show(interval = 100) {
        if (_shown) return;
        _shown = true;

        const box = document.getElementById('uiLoader');
        const text = document.getElementById('uiLoaderText');
        if (!box || !text) return;

        _count = 1;
        text.textContent = '1';
        box.classList.add('show');

        _timer = setInterval(() => {
          _count++;
          text.textContent = String(_count);
        }, interval);
      },

      hide() {
        if (_timer) {
          clearInterval(_timer);
          _timer = null;
        }

        _count = 1;
        _shown = false;

        const box = document.getElementById('uiLoader');
        if (box) box.classList.remove('show');
      }
    };

  })();

  /* ===============================
     METADATA
=============================== */
  window.UI_VERSION = {
    toast: '1.1.0',
    loader: '1.1.0',
    scope: 'core'
  };

})();
</script>


