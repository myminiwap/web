<style>
.sheet-popup {
  position: fixed;
  inset: 0;
  background: #fff;
  z-index: 99999;
}

.sheet-popup.hidden {
  display: none;
}

.sheet-popup iframe {
  border: 0;
  transform: scale(1.2);
  transform-origin: top left;
  width: 83.33%;
  height: 83.33%;
}

.sheet-popup-close {
  position: fixed;
  top: 8px;
  right: 8px;
  z-index: 100000;
  pointer-events: auto;

  border: none;
  background: #000;
  color: #fff;

  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 16px;
}
</style>

<!-- ===============================
     SHEET POPUP MARKUP
=============================== -->
<div id="sheetViewPopup" class="sheet-popup hidden">
  <button class="sheet-popup-close" onclick="closeSheetPopup()">✕</button>
  <iframe id="sheetViewFrame" loading="lazy"></iframe>
</div>

<script>
(function () {

  function qs(id) {
    return document.getElementById(id);
  }

  window.openSheetInPopup = function (url) {
    if (!url) return;
    qs('sheetViewFrame').src = url;
    qs('sheetViewPopup').classList.remove('hidden');
  };

  window.closeSheetPopup = function () {
    qs('sheetViewFrame').src = 'about:blank';
    qs('sheetViewPopup').classList.add('hidden');
  };

})();
</script>
